#!/bin/sh
BIN=/data/.yactl/yactl
DATA=/data/.yactl
case "$1" in
  start)
    if "$BIN" --root "$DATA" status >/dev/null 2>&1; then exit 0; fi
    "$BIN" --root "$DATA" daemon --detach
    ;;
  stop)
    if "$BIN" --root "$DATA" status >/dev/null 2>&1; then
      "$BIN" --root "$DATA" shutdown || exit 1
      attempts=0
      while [ -e "$DATA/manager.pid" ] || [ -S "$DATA/control.sock" ]; do
        attempts=$((attempts + 1))
        if [ "$attempts" -ge 10 ]; then
          echo "yactl: shutdown deadline exceeded" >&2
          exit 1
        fi
        sleep 1
      done
    fi
    ;;
  restart) "$0" stop && "$0" start ;;
  status) "$BIN" --root "$DATA" status ;;
  *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
